{
  "name": "studium",
  "version": "0.1.0",
  "description": "Offline study app: subjects, handouts, PDFs, study notes, flashcards and school. Plain Markdown files.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node tools/excalidraw-fonts.mjs && tsc && vite build",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "android": "npm run build && cap sync android",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tgrosinger/md-advanced-tables": "3.11.0",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "katex": "0.19.0",
    "lucide-react": "^1.59.0",
    "lz-string": "^1.5.0",
    "mermaid": "12.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "author": {
    "name": "Leonardo Sponton",
    "email": "230742162+Leonardo-Sponton@users.noreply.github.com"
  },
  "build": {
    "appId": "io.github.leonardo_sponton.studium",
    "productName": "Studium",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "package.json",
      "!node_modules/@capacitor/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "resources/icon.png",
      "category": "Education",
      "executableName": "studium",
      "synopsis": "Offline study notes, handouts and flashcards",
      "desktop": {
        "entry": {
          "StartupWMClass": "Studium"
        }
      },
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Studium-${version}-${arch}.AppImage"
    },
    "artifactName": "studium-${version}-${arch}.${ext}"
  },
  "desktopName": "studium.desktop"
}
